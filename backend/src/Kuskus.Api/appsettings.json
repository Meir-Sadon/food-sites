{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "MigrateOnStartup": false
  },
  "Admin": {
    "SessionHours": 12,
    "LoginAttemptsPerMinute": 5
  },
  "AuthCookie": {
    "Secure": true,
    "SameSite": "Lax"
  },
  "ForwardedHeaders": {
    "Enabled": false
  }
}
